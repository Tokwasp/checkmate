JWT_SECRET=

# 소셜 로그인 없이 토큰을 받는 개발용 엔드포인트(POST /api/v1/auth/dev-login) 활성화. 운영에서는 false 또는 비움.
DEV_LOGIN_ENABLED=true

# 운영(prod) 프로필 전용. RDS MySQL 접속 정보 — 로컬 개발(H2)에서는 사용하지 않음.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# 구글 Cloud Console > 사용자 인증 정보 > "웹 애플리케이션" 클라이언트 ID (.../apps.googleusercontent.com)
# 프론트 EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID 와 동일 값. 서버가 구글 ID 토큰의 aud 클레임과 비교한다. 시크릿 아님.
GOOGLE_CLIENT_ID=

# 체크리스트 추천(15번)에 쓰는 SSAFY GMS 게이트웨이. OpenAI 호환 chat completions 요청/응답
# 형식으로 가정한다. GMS_BASE_URL은 호스트만이 아니라 실제 호출 엔드포인트 전체 경로까지
# 넣어야 한다(예: https://.../v1/chat/completions) — 코드가 경로를 추가로 붙이지 않는다.
GMS_BASE_URL=
GMS_KEY=
# 기본값 gpt-4o-mini. 게이트웨이가 지원하는 실제 모델명으로 바꿔야 할 수 있음.
GMS_MODEL=

# 여행 생성/수정(6/8번)의 목적지 자동완성 + 좌표 확보에 쓰는 Google Places API(New) 키.
# GCP 결제 계정(카드) 등록이 필요하다 — 팀에 카드가 없어 아직 실제로 발급/검증하지 못했다
# (docs/travel/docs.md §9-8). Places API(New)를 활성화한 프로젝트의 API 키를 넣는다.
GOOGLE_PLACES_KEY=

# 물품 인식 등록(26번)의 인벤토리 사진 저장소. 비워두면 S3 대신 STORAGE_LOCAL_DIR(기본 ./uploads)에
# 저장하고 /uploads/... 경로로 서빙한다 — 로컬 개발용이고 서버가 여러 대면 파일이 흩어진다.
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
# 비우면 EC2 IAM 역할 등 AWS 기본 자격증명 체인을 쓴다.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# CloudFront 등 별도 도메인을 쓸 때만. 비우면 https://{버킷}.s3.{리전}.amazonaws.com 을 쓴다.
AWS_S3_BASE_URL=

# 반입 규정 검사(30번)의 Bedrock Knowledge Base. 비워두면 검사 요청이 실패한다.
# 자격증명은 따로 받지 않고 AWS 기본 자격증명 체인(EC2 IAM 역할, 로컬 ~/.aws)을 쓴다.
BEDROCK_KB_ID=
AWS_BEDROCK_REGION=ap-northeast-2
# Sonnet 4.6과 정확도가 같으면서 비용 1/3 (RAG_검색품질_모델선정_리포트.md 참고).
# 모델을 Sonnet 5 이상으로 올릴 때는 코드의 temperature 설정을 함께 빼야 한다(400 발생).
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# 물품 이름 하나당 가져올 규정 청크 수. 10으로 내리면 칼 규정이 검색에서 빠진다 — 15 밑으로 내리지 말 것.
BEDROCK_SEARCH_RESULTS=15
BEDROCK_MAX_TOKENS=4000
