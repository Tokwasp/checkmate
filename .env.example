JWT_SECRET=

# 소셜 로그인 없이 토큰을 받는 개발용 엔드포인트(POST /api/v1/auth/dev-login) 활성화. 운영에서는 false 또는 비움.
DEV_LOGIN_ENABLED=true

# 구글 Cloud Console > 사용자 인증 정보 > "웹 애플리케이션" 클라이언트 ID (.../apps.googleusercontent.com)
# 프론트 EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID 와 동일 값. 서버가 구글 ID 토큰의 aud 클레임과 비교한다. 시크릿 아님.
GOOGLE_CLIENT_ID=
