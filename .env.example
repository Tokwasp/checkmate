JWT_SECRET=

# 소셜 로그인 없이 토큰을 받는 개발용 엔드포인트(POST /api/v1/auth/dev-login) 활성화. 운영에서는 false 또는 비움.
DEV_LOGIN_ENABLED=true

# 구글 Cloud Console > 사용자 인증 정보 > "웹 애플리케이션" 클라이언트 ID (.../apps.googleusercontent.com)
# 프론트 EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID 와 동일 값. 서버가 구글 ID 토큰의 aud 클레임과 비교한다. 시크릿 아님.
GOOGLE_CLIENT_ID=

# 체크리스트 추천(15번)에 쓰는 SSAFY GMS 게이트웨이. OpenAI 호환 chat completions 요청/응답
# 형식으로 가정한다. GMS_BASE_URL은 호스트만이 아니라 실제 호출 엔드포인트 전체 경로까지
# 넣어야 한다(예: https://.../v1/chat/completions) — 코드가 경로를 추가로 붙이지 않는다.
GMS_BASE_URL=
GMS_KEY=
# 기본값 gpt-4o-mini. 게이트웨이가 지원하는 실제 모델명으로 바꿔야 할 수 있음.
GMS_MODEL=

# 여행 생성/수정(6/8번)의 목적지 자동완성 + 좌표 확보에 쓰는 Google Places API(New) 키.
# GCP 결제 계정(카드) 등록이 필요하다 — 팀에 카드가 없어 아직 실제로 발급/검증하지 못했다
# (docs/travel/docs.md §9-8). Places API(New)를 활성화한 프로젝트의 API 키를 넣는다.
GOOGLE_PLACES_KEY=
